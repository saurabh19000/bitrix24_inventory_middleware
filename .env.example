# Copy this file to `.env` at the project root and change the secrets.
# Values here are read by docker-compose.yml and passed into the containers.
# Defaults already exist in docker-compose.yml, so everything is optional
# except the secrets you should override.

# PostgreSQL
POSTGRES_PASSWORD=change-me-strong-password

# Backend
JWT_SECRET=change-me-to-a-long-random-string
BITRIX_ENCRYPTION_KEY=a-32-character-encryption-key-here
ADMIN_EMAIL=admin@system.com
ADMIN_PASSWORD=Admin@123456

# Set to "true" when serving over HTTPS, otherwise browsers will reject the
# auth cookie over plain HTTP (docker-compose already passes COOKIE_SECURE=false).
COOKIE_SECURE=false