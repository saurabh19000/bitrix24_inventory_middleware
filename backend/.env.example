NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/bitrix_inventory
REDIS_URL=redis://redis:6379
JWT_SECRET=change-me-to-a-secure-random-string-in-production
ADMIN_EMAIL=admin@system.com
ADMIN_PASSWORD=Admin@123456
BITRIX_ENCRYPTION_KEY=change-me-to-a-32-char-encryption-key!!
MAX_FILE_SIZE_MB=10
BITRIX_CONCURRENCY=5
BITRIX_MAX_RETRIES=3
BITRIX_REQUEST_TIMEOUT=30000
BATCH_SIZE=50
COOKIE_DOMAIN=localhost